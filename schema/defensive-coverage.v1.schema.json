{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Defensive coverage profile v1",
  "description": "Research sidecar for one catalog page. Catalog canonical data and detection maturity contracts remain independent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "maturity",
    "deck",
    "scope",
    "references",
    "observationFamilies",
    "collectionSources",
    "presets",
    "variations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "enum": [
        "Research",
        "Hunt",
        "Analyst"
      ]
    },
    "deck": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "initialVariation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "initialObservation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "behavioralGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "baseline",
        "explorer"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/assets/data/[a-z0-9/-]+(?:\\.[a-z0-9-]+)*\\.json$"
        },
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "explorer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/lens-explorer/[a-z0-9-]+/$"
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "observationFamilies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observationFamily"
      }
    },
    "collectionSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/collectionSource"
      }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/preset"
      }
    },
    "variations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variation"
      }
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "evidenceExamples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceExample"
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observationFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "short"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "short": {
          "type": "string",
          "minLength": 1
        },
        "collectionAny": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "collectionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "state",
        "relevance",
        "establishes",
        "limit"
      ],
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "state": {
          "enum": [
            "source",
            "measured",
            "synthetic",
            "context",
            "unavailable",
            "hypothesis"
          ]
        },
        "relevance": {
          "type": "string",
          "minLength": 1
        },
        "establishes": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "requiresAny",
        "qualification"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "requiresAny": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "description": "OR of all-of source requirements; [] is reserved for a documented unavailable claim in the named capture."
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "const": "unavailable"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requiresAny": {
                "maxItems": 0
              }
            },
            "required": [
              "requiresAny"
            ]
          },
          "then": {
            "required": [
              "availability"
            ]
          },
          "else": {
            "not": {
              "required": [
                "availability"
              ]
            }
          }
        }
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "detection",
        "prevention",
        "deception",
        "investigation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "detection": {
          "type": "string",
          "minLength": 1
        },
        "prevention": {
          "type": "string",
          "minLength": 1
        },
        "deception": {
          "type": "string",
          "minLength": 1
        },
        "investigation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "variation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "scope",
        "refs",
        "observations",
        "claims",
        "hunt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objective",
            "route"
          ],
          "properties": {
            "objective": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "route": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "hunt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "provenance",
        "study",
        "locator",
        "refs",
        "fields",
        "identifies",
        "establishes",
        "limits",
        "strengthen",
        "administrative"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "native-projection",
            "supplemental",
            "synthetic",
            "source-summary"
          ]
        },
        "study": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "value"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "identifies": {
          "type": "string",
          "minLength": 1
        },
        "establishes": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "string",
          "minLength": 1
        },
        "strengthen": {
          "type": "string",
          "minLength": 1
        },
        "administrative": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "confirmed",
        "denominator"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "description": "Fixed eligible denominator for this claim and cohort. A zero denominator should have no metric."
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "metrics"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "lenses": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric"
          }
        }
      }
    },
    "minimum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "claim",
        "lenses",
        "scope"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "lenses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "provenance",
        "refs",
        "lead",
        "interpretation",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "featured": {
          "type": "boolean"
        },
        "provenance": {
          "enum": [
            "source",
            "hypothesis",
            "measured",
            "synthetic"
          ]
        },
        "study": {
          "type": "string",
          "minLength": 1
        },
        "cohort": {
          "type": "string",
          "minLength": 1
        },
        "cutoff": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comparison"
          }
        },
        "minima": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/minimum"
          }
        },
        "lensKey": {
          "minLength": 1,
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "comparisons"
                ]
              },
              {
                "required": [
                  "minima"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "study",
              "cohort",
              "cutoff"
            ],
            "properties": {
              "provenance": {
                "enum": [
                  "measured",
                  "synthetic"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
